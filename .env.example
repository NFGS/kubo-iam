# kubo-iam — variables de entorno
# Copiar a .env y ajustar. NUNCA versionar el .env real.

PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/kubo_iam
SPRING_DATASOURCE_USERNAME=kubo_iam
SPRING_DATASOURCE_PASSWORD=cambiar_password

# Llave RSA privada (PKCS#8 PEM en una linea, con \n).
# Generar con: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt
# Si se deja vacia, el servicio genera un par efimero en memoria (solo desarrollo).
KUBO_JWT_PRIVATE_KEY=

KUBO_ACCESS_TOKEN_MINUTES=15
KUBO_REFRESH_TOKEN_DAYS=7

KUBO_SEED_ENABLED=true
KUBO_ADMIN_EMAIL=admin@kubo.local
KUBO_ADMIN_PASSWORD=Admin123!
KUBO_TENANT_NAME=Tienda La Esquina
